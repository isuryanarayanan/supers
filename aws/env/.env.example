# Supers backend/functions runtime environment
# Copy this file to aws/env/.env.dev for local serverless-offline development.
# Copy/adapt to aws/env/.env.production for production runtime config.

# AWS resources
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=supers-files-dev-your-unique-name
DYNAMODB_TABLE_NAME=Supers-Posts-Dev

# Admin authentication
# Generate a strong secret with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-secret-at-least-64-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=devpassword123

# CORS: frontend origin allowed to call API
ALLOWED_ORIGIN=http://localhost:3000

# File upload limits
MAX_FILE_SIZE=1073741824
ALLOWED_FILE_TYPES=image/*,video/*,audio/*,application/pdf,text/*

# AWS credentials
# Prefer `aws configure` or exported shell env vars when possible.
# These are needed for local functions because they access real AWS S3/DynamoDB.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=only-if-using-temporary-credentials
