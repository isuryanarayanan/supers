# Supers backend deployment environment
# Copy this file to one of:
# - aws/env/.env.deployment.dev
# - aws/env/.env.deployment.prod
# Used by package scripts deploy:api:* and remove:api:*.

# AWS deployment credentials with permissions for CloudFormation, Lambda,
# API Gateway, IAM role/policy updates, S3, DynamoDB, and CloudWatch Logs.
AWS_ACCESS_KEY_ID=your-deployment-access-key-id
AWS_SECRET_ACCESS_KEY=your-deployment-secret-access-key
# AWS_SESSION_TOKEN=only-if-using-temporary-credentials
AWS_REGION=ap-south-1

# Optional if using AWS profiles instead of access keys.
# AWS_PROFILE=supers-deployment
