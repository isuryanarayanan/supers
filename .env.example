# Supers frontend / Next.js environment
# Copy this file to .env.local for local UI development.

# Local API URL used by admin/auth/posts/files UI.
# If you only want to run the static UI, this can be left empty.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/dev

# Default theme: light or dark
NEXT_PUBLIC_DEFAULT_THEME=light

# Frontend upload validation limit in bytes. 1073741824 = 1GB.
NEXT_PUBLIC_MAX_FILE_SIZE=1073741824

# Optional base path for subpath deployments, e.g. GitHub Pages: /supers
# Leave empty for local development or root-domain deployments.
NEXT_PUBLIC_BASE_PATH=
